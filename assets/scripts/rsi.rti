# RSI(6,12,24)
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_FIXED(0,20,50,80,100);
LC: REF(C,1);
UP: MAX(C-LC,0);
DN: ABS(C-LC);
RSI1: 100*MA(UP,6)/(MA(UP,6)+MA(DN,6)+0.000001);
RSI2: 100*MA(UP,12)/(MA(UP,12)+MA(DN,12)+0.000001);
RSI3: 100*MA(UP,24)/(MA(UP,24)+MA(DN,24)+0.000001);
LINE(RSI1,SYSTEM_COLOR(RSI1),1);
LINE(RSI2,SYSTEM_COLOR(RSI2),1);
LINE(RSI3,SYSTEM_COLOR(RSI3),1);
HLINE(20,SYSTEM_COLOR(ZERO),1);
HLINE(80,SYSTEM_COLOR(ZERO),1);
STATUS_FIELD("RSI1",RSI1,SYSTEM_COLOR(RSI1),"0.00");
STATUS_FIELD("RSI2",RSI2,SYSTEM_COLOR(RSI2),"0.00");
STATUS_FIELD("RSI3",RSI3,SYSTEM_COLOR(RSI3),"0.00");
