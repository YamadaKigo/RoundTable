# 成交量
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_AUTO(1);
VMA5: MA(V,5);
VMA10: MA(V,10);
VOL(UP,DOWN,1,1);
LINE(VMA5,SYSTEM_COLOR(MA1),1);
LINE(VMA10,SYSTEM_COLOR(MA2),1);
STATUS_FIELD("量",V,SYSTEM_COLOR(TEXT),"0");
STATUS_FIELD("VMA5",VMA5,SYSTEM_COLOR(MA1),"0.00");
STATUS_FIELD("VMA10",VMA10,SYSTEM_COLOR(MA2),"0.00");
