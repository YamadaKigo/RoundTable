# CCI(14)
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_SHOW(1);
CROSSHAIR_SHOW(1);

TP: (H+L+C)/3;
MATP: MA(TP,14);
MD: MA(ABS(TP-MATP),14);
CCIV: (TP-MATP)/(0.015*MD);

LINE(CCIV,SYSTEM_COLOR(CCI),1);
HLINE(100,SYSTEM_COLOR(ZERO),1);
HLINE(-100,SYSTEM_COLOR(ZERO),1);
STATUS_FIELD("CCI",CCIV,SYSTEM_COLOR(CCI));