# 美国线
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_AUTO(0);
MA5: MA(C,5);
MA10: MA(C,10);
MA20: MA(C,20);
MA60: MA(C,60);
LINE(MA5,SYSTEM_COLOR(MA1),1);
LINE(MA10,SYSTEM_COLOR(MA2),1);
LINE(MA20,SYSTEM_COLOR(MA3),1);
LINE(MA60,SYSTEM_COLOR(MA4),1);
OHLC(UP,DOWN,1);
STATUS_FIELD("开",O,SYSTEM_COLOR(TEXT),"0.00");
STATUS_FIELD("高",H,SYSTEM_COLOR(TEXT),"0.00");
STATUS_FIELD("低",L,SYSTEM_COLOR(TEXT),"0.00");
STATUS_FIELD("收",C,SYSTEM_COLOR(TEXT),"0.00");
