# Candles
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_SHOW(1);
CROSSHAIR_SHOW(1);

MA5: MA(C,5);
MA10: MA(C,10);
MA20: MA(C,20);
MA60: MA(C,60);

LINE(MA5,SYSTEM_COLOR(MA1),1);
LINE(MA10,SYSTEM_COLOR(MA2),1);
LINE(MA20,SYSTEM_COLOR(MA3),1);
LINE(MA60,SYSTEM_COLOR(MA4),1);
CANDLE(UP,DOWN,1);
STATUS_FIELD("Open",O,SYSTEM_COLOR(TEXT));
STATUS_FIELD("High",H,SYSTEM_COLOR(TEXT));
STATUS_FIELD("Low",L,SYSTEM_COLOR(TEXT));
STATUS_FIELD("Close",C,SYSTEM_COLOR(TEXT));