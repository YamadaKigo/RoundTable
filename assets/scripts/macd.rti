# MACD(12,26,9)
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_SHOW(1);
CROSSHAIR_SHOW(1);

DIF: EMA(C,12)-EMA(C,26);
DEA: EMA(DIF,9);
MACD: 2*(DIF-DEA);
HIST(MACD,UP,DOWN,0,1);

LINE(DIF,SYSTEM_COLOR(DIF),1);
LINE(DEA,SYSTEM_COLOR(DEA),1);
ZERO(SYSTEM_COLOR(ZERO),1);
STATUS_FIELD("DIF",DIF,SYSTEM_COLOR(DIF));
STATUS_FIELD("DEA",DEA,SYSTEM_COLOR(DEA));
STATUS_FIELD("MACD",MACD,SYSTEM_COLOR(TEXT));