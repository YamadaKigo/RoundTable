# BIAS(6,12,24)
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_SHOW(1);
CROSSHAIR_SHOW(1);
MA6: MA(C,6);
MA12: MA(C,12);
MA24: MA(C,24);
BIAS1: (C-MA6)/MA6*100;
BIAS2: (C-MA12)/MA12*100;
BIAS3: (C-MA24)/MA24*100;
LINE(BIAS1,SYSTEM_COLOR(BIAS1),1);
LINE(BIAS2,SYSTEM_COLOR(BIAS2),1);
LINE(BIAS3,SYSTEM_COLOR(BIAS3),1);
ZERO(SYSTEM_COLOR(ZERO),1);
STATUS_FIELD("BIAS1",BIAS1,SYSTEM_COLOR(BIAS1));
STATUS_FIELD("BIAS2",BIAS2,SYSTEM_COLOR(BIAS2));
STATUS_FIELD("BIAS3",BIAS3,SYSTEM_COLOR(BIAS3));
