# OBV
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_SHOW(1);
CROSSHAIR_SHOW(1);
UPV: IF(C>REF(C,1),V,0);
DNV: IF(C<REF(C,1),-V,0);
OBVALUE: SUM(UPV+DNV,0);
LINE(OBVALUE,SYSTEM_COLOR(OBV),1);
OBVMA: MA(OBVALUE,30);
LINE(OBVMA,SYSTEM_COLOR(MA1),1);
ZERO(SYSTEM_COLOR(ZERO),1);
STATUS_FIELD("OBV",OBVALUE,SYSTEM_COLOR(OBV));
STATUS_FIELD("OBVMA",OBVMA,SYSTEM_COLOR(MA1));
