# BOLL(20,2)
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_SHOW(1);
CROSSHAIR_SHOW(1);

MID: MA(C,20);
DEV: STD(C,20);
UPPER: MID+2*DEV;
LOWER: MID-2*DEV;

LINE(UPPER,SYSTEM_COLOR(BOLL_UP),1);
LINE(MID,SYSTEM_COLOR(BOLL_MID),1);
LINE(LOWER,SYSTEM_COLOR(BOLL_DOWN),1);
CANDLE(UP,DOWN,1);
STATUS_FIELD("Upper",UPPER,SYSTEM_COLOR(BOLL_UP));
STATUS_FIELD("Middle",MID,SYSTEM_COLOR(BOLL_MID));
STATUS_FIELD("Lower",LOWER,SYSTEM_COLOR(BOLL_DOWN));