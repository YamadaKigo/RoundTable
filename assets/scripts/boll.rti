# BOLL(20,2)
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_AUTO(0);
MID: MA(C,20);
DEV: STD(C,20);
UPPER: MID+2*DEV;
LOWER: MID-2*DEV;
LINE(UPPER,SYSTEM_COLOR(BOLL_UP),1);
LINE(MID,SYSTEM_COLOR(BOLL_MID),1);
LINE(LOWER,SYSTEM_COLOR(BOLL_DOWN),1);
CANDLE(UP,DOWN,1);
STATUS_FIELD("上轨",UPPER,SYSTEM_COLOR(BOLL_UP),"0.00");
STATUS_FIELD("中轨",MID,SYSTEM_COLOR(BOLL_MID),"0.00");
STATUS_FIELD("下轨",LOWER,SYSTEM_COLOR(BOLL_DOWN),"0.00");
