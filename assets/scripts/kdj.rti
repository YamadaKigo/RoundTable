# KDJ(9,3,3)
STATUS_SHOW(1);
TIME_SHOW(1);
AXIS_SHOW(1);
CROSSHAIR_SHOW(1);
LOW9: LLV(L,9);
HIGH9: HHV(H,9);
RSV: (C-LOW9)/(HIGH9-LOW9)*100;
K: EMA(RSV,3);
D: EMA(K,3);
J: 3*K-2*D;
LINE(K,SYSTEM_COLOR(K),1);
LINE(D,SYSTEM_COLOR(D),1);
LINE(J,SYSTEM_COLOR(J),1);
HLINE(20,SYSTEM_COLOR(ZERO),1);
HLINE(80,SYSTEM_COLOR(ZERO),1);
STATUS_FIELD("K",K,SYSTEM_COLOR(K));
STATUS_FIELD("D",D,SYSTEM_COLOR(D));
STATUS_FIELD("J",J,SYSTEM_COLOR(J));
