{
  "format": "roundtable-theme",
  "version": 2,
  "id": "light",
  "name": "浅色",
  "colors": {
    "application": {
      "title_bar": {
        "background": "#BBBBBB",
        "pattern": "#999999",
        "text": "#000000"
      },
      "menu_bar": {
        "background": "#DDDDDD",
        "text": "#000000",
        "hover": "#AAAAAA",
        "border": "#999999",
        "separator": "#999999"
      },
      "workspace": {
        "background": "#EEEEEE"
      },
      "taskbar": {
        "background": "#CCCCCC",
        "text": "#000000",
        "border": "#999999"
      },
      "status_bar": {
        "background": "#CCCCCC",
        "text": "#000000",
        "border": "#999999"
      }
    },
    "window": {
      "content_background": "#FFFFFF",
      "panel_background": "#DDDDDD",
      "border": "#999999",
      "splitter": "#AAAAAA",
      "symbol": "#000000",
      "text": "#000000"
    },
    "controls": {
      "button": {
        "face": "#CCCCCC",
        "hover": "#DDDDDD",
        "pressed": "#AAAAAA",
        "text": "#000000",
        "border": "#999999"
      },
      "generic_border": "#999999",
      "selection_background": "#DDDDDD",
      "text_input": {
        "background": "#FFFFFF",
        "text": "#000000",
