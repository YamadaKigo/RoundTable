    "indicators": {
      "dif": "#3333CC",
      "dea": "#CC9900",
      "kdj_k": "#3333CC",
      "kdj_d": "#CC9900",
      "kdj_j": "#FF00FF",
      "rsi_1": "#3333CC",
      "rsi_2": "#CC9900",
      "rsi_3": "#FF00FF",
      "boll_mid": "#3366CC",
      "boll_up": "#CC0066",
      "boll_down": "#009999",
      "obv": "#CC6600",
      "cci": "#6600CC",
      "bias": ["#3333CC", "#CC9900", "#FF00FF"],
      "ma": ["#3333CC", "#CC0066", "#009933", "#6600CC", "#009999", "#666666"],
      "ema": ["#FF00FF", "#FF8800", "#00CCCC", "#88AA00", "#8888FF", "#AA00AA"]
