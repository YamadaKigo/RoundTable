    "editor": {
      "background": "#FFFFFF",
      "gutter_background": "#DDDDDD",
      "text": "#000000",
      "comment": "#009900",
      "keyword": "#0000FF",
      "line_number": "#666666",
      "border": "#999999"
    },
    "chart": {
      "background": "#FFFFFF",
      "border": "#999999",
      "axis_background": "#DDDDDD",
      "tick": "#DDDDDD",
      "crosshair": "#666666",
